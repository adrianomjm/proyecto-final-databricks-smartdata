{
  "datasets": [
    {
      "name": "c94d2c61",
      "displayName": "top_directors",
      "queryLines": [
        "SELECT \r\n",
        "  director,\r\n",
        "  cantidad_peliculas,\r\n",
        "  ROUND(revenue_total / 1000000, 2) AS revenue_millones,\r\n",
        "  ROUND(score_promedio, 2) AS score\r\n",
        "FROM catalog_proyectosmartdata.golden.kpi_por_director\r\n",
        "ORDER BY revenue_total DESC\r\n",
        "LIMIT 15"
      ],
      "catalog": "catalog_proyectosmartdata",
      "schema": "golden"
    },
    {
      "name": "cf7eaab8",
      "displayName": "por_genero",
      "queryLines": [
        "SELECT \r\n",
        "  genre_principal,\r\n",
        "  cantidad_peliculas,\r\n",
        "  ROUND(score_promedio, 2) AS score\r\n",
        "FROM catalog_proyectosmartdata.golden.kpi_por_genero\r\n",
        "ORDER BY cantidad_peliculas DESC"
      ],
      "catalog": "catalog_proyectosmartdata",
      "schema": "golden"
    }
  ],
